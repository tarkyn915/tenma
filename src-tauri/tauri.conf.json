{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tenma Player",
  "version": "0.2.1",
  "identifier": "com.tenma.music",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tenma Player",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "windows": {
      "wix": {
        "upgradeCode": "5220f896-b91f-52d0-a086-c543c7f14bf2"
      },
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFRTg0RDFDNzhBMjBEN0UKUldSK0RhSjRIRTNvTHVjSzVQbXE2Y1d3WFFYYzFPbnY1ZW9JQ2RzeXk4U2Nkck1kNk9DUDc3NWUK",
      "endpoints": [
        "https://github.com/tarkyn915/tenma/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
